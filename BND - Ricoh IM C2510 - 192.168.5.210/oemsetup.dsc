[DrvInst]
DrvInst=Gestetner IM C2010 PCL 6,Gestetner GS4020c PCL 6,Gestetner IM C2510 PCL 6,Gestetner GS4025c PCL 6,NRG IM C2010 PCL 6,NRG IM C2510 PCL 6,RICOH IM C2010 PCL 6,RICOH IM C2510 PCL 6,RICOH IM C2519J PCL 6
Comment="PCL6 Driver (For Windows)"
DriverType=PCL6
DriverArchitecture=ARC2010
Version=3
IniFileName=rpdinstv.ini,allusers
IniFileSupport=4
ScenarioInstallOK=ON
RConfigFileOSVersion=3
DriverVersion=1.2.0.0
Platform=NTamd64
RCFFormatVersion=1.0
UserCodeOK=ON
ModelName.Gestetner IM C2010 PCL 6 = "IM C2010"
ModelName.Gestetner GS4020c PCL 6 = "GS4020c"
ModelName.Gestetner IM C2510 PCL 6 = "IM C2510"
ModelName.Gestetner GS4025c PCL 6 = "GS4025c"
ModelName.NRG IM C2010 PCL 6 = "IM C2010"
ModelName.NRG IM C2510 PCL 6 = "IM C2510"
ModelName.RICOH IM C2010 PCL 6 = "IM C2010"
ModelName.RICOH IM C2510 PCL 6 = "IM C2510"
ModelName.RICOH IM C2519J PCL 6 = "IM C2519J"
USBPermit=ON
UserIDSupportLevel=1
PackageInstall=ON
OneTimePopupSupport=ON
PopupLockSupport=ON
EnableSNMP=OFF
USBNullDriverInfFileName=RPRNUT.INF
WatermarkCustomizeSupport=ON
